#VRML_SIM R2025a utf8
# Pista UCAB Robotica (medida el 2026-10-15): tablero blanco de 1.82 x 0.94 m (margen supuesto, no medido),
# rectangulo de cinta negra de 1.8 cm de 120.6 x 74 cm (borde exterior) y cuadrado de entrega AZUL de
# 20.3 x 20.3 cm que sobresale del lado oeste (su lado hacia la pista no tiene cinta). 14 cubos de 2 cm.
# Marco: origen en el centro del rectangulo, x al este (lado de 120.6 cm), y al norte. La textura y los
# cubos salen de tools/sim/generate_track.py (fuente unica de la geometria).
# ROS 2: both robots use controller "<extern>" and are driven by multirobot_sim.recolector_driver (webots_ros2).
# To drive them by keyboard instead, set controller back to "recolector_teleop".

EXTERNPROTO "../protos/RecolectorUCAB.proto"
EXTERNPROTO "../protos/CuboMadera.proto"

WorldInfo {
  info [
    "Pista UCAB - recolectores Phineas y Ferb"
    "Phineas: rojo, naranja, amarillo. Ferb: verde, azul, morado (propuesta del plan)."
  ]
  title "Pista UCAB"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "InteriorWheelMat"
      coulombFriction [ 0, 2, 0 ]
      frictionRotation -0.785398 0
      bounce 0
      forceDependentSlip [ 10, 0 ]
    }
    ContactProperties {
      material1 "ExteriorWheelMat"
      coulombFriction [ 0, 2, 0 ]
      frictionRotation 0.785398 0
      bounce 0
      forceDependentSlip [ 10, 0 ]
    }
  ]
}
Viewpoint {
  orientation -0.3236 0.3236 0.8891 1.688
  position 0 -1.75 1.45
  follow ""
}
Background {
  skyColor [ 0.86 0.84 0.82 ]
  luminosity 0.8
}
DirectionalLight {
  direction 0.2 0.3 -1
  intensity 1.6
  castShadows TRUE
}
PointLight {
  location 0 0 2.2
  intensity 1.2
  radius 6
}
DEF PISO Solid {
  translation 0 0 -0.778
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.55 0.53 roughness 1 metalness 0 }
      geometry Plane { size 8 8 }
    }
  ]
  name "piso"
  boundingObject Plane { size 8 8 }
}
DEF MESA Solid {
  translation 0 0 -0.398
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.35 0.22 0.14 roughness 0.8 metalness 0 }
      geometry Box { size 1.8 0.92 0.76 }
    }
  ]
  name "mesa"
  boundingObject Box { size 1.8 0.92 0.76 }
}
DEF PISTA Solid {
  translation 0 0 -0.009
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.93 0.94 0.95 roughness 0.9 metalness 0 }
      geometry Box { size 1.82 0.94 0.018 }
    }
    Pose {
      translation 0 0 0.0091
      children [
        Shape {
          appearance PBRAppearance {
            baseColorMap ImageTexture { url [ "textures/pista_ucab.png" ] }
            roughness 0.9
            metalness 0
          }
          geometry Plane { size 1.82 0.94 }
        }
      ]
    }
  ]
  name "pista"
  model "pista"
  boundingObject Box { size 1.82 0.94 0.018 }
}
DEF MARCADOR_CUADRADO Solid {
  # ArUco id 10 west of the blue square, outside the tape, facing east (toward the approaching robot).
  translation -0.84 0.0085 0
  children [
    Pose {
      translation 0 0 0.003
      children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.2 roughness 1 metalness 0 } geometry Box { size 0.03 0.12 0.006 } } ]
    }
    Pose {
      translation 0 0.0 0.065
      rotation 0.577 0.577 0.577 2.094
      children [ Shape { appearance PBRAppearance { baseColorMap ImageTexture { url [ "textures/aruco_cuadrado_id10.png" ] filtering 0 } roughness 1 metalness 0 } geometry Plane { size 0.1 0.1 } } ]
    }
  ]
  name "marcador_cuadrado"
  boundingObject Pose { translation 0 0 0.04 children [ Box { size 0.03 0.12 0.08 } ] }
}
DEF PHINEAS RecolectorUCAB {
  translation 0.4 0.2 0
  rotation 0 0 1 3.14159
  name "Phineas"
  controller "<extern>"
  controllerArgs [ "--colores=rojo,naranja,amarillo" ]
  marcadorUrl [ "textures/aruco_phineas_id1.png" ]
  extensiones [
    # Front-center line sensor: the real robot has ONE TCRT5000 (GPIO5), published as line_front.
    DistanceSensor {
      translation 0.075 0 0.012
      rotation 0 1 0 1.5708
      name "linea_frente"
      type "infra-red"
      lookupTable [ 0 1023 0.01, 0.025 0 0.01 ]
      numberOfRays 1
    }
    # GPS + InertialUnit ONLY emulate the overhead ArUco camera pose (/<robot>/pose).
    GPS {
      name "gps"
    }
    InertialUnit {
      name "imu_sim"
    }
  ]
}
DEF FERB RecolectorUCAB {
  translation 0.4 -0.2 0
  rotation 0 0 1 3.14159
  name "Ferb"
  controller "<extern>"
  controllerArgs [ "--colores=verde,azul,morado" ]
  marcadorUrl [ "textures/aruco_ferb_id2.png" ]
  colorChasis 0.1 0.12 0.25
  extensiones [
    # Front-center line sensor: the real robot has ONE TCRT5000 (GPIO5), published as line_front.
    DistanceSensor {
      translation 0.075 0 0.012
      rotation 0 1 0 1.5708
      name "linea_frente"
      type "infra-red"
      lookupTable [ 0 1023 0.01, 0.025 0 0.01 ]
      numberOfRays 1
    }
    # GPS + InertialUnit ONLY emulate the overhead ArUco camera pose (/<robot>/pose).
    GPS {
      name "gps"
    }
    InertialUnit {
      name "imu_sim"
    }
  ]
}
