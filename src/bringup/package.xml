<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>Launch files for Phineas and Ferb in Webots and on the real robots.</description>
  <maintainer email="team@example.com">UCAB Robotica team</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mobile_base</exec_depend>
  <exec_depend>coordinator</exec_depend>
  <exec_depend>overhead_localization</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- sim.launch.py additionally needs multirobot_sim and webots_ros2_driver (host install only). -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
